# ==============================================================================
# SyncNShare — Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   1. server/.env (for local backend development)
#   2. client/.env (for local frontend development)
#
# NEVER commit real credentials, passwords, or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS (used by server/)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Persistent MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/syncnshare?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/syncnshare
MONGODB_URI=mongodb://localhost:27017/syncnshare

# Allowed Frontend Origin for CORS & Socket.IO connections
CLIENT_ORIGIN=http://localhost:5173

# Authentication Secrets (Generate secure random 32+ character strings for production)
JWT_SECRET=development-only-jwt-secret-replace-in-production-1234567890
COOKIE_SECRET=development-only-cookie-secret-replace-in-production-1234567890

# Pino Logging Verbosity (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Rate Limiting (Requests per 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (used by client/)
# ------------------------------------------------------------------------------
# Leave empty or set to /api/v1 when using Vite proxy in local dev.
# In production, set to your backend deployment origin (e.g. https://api.syncnshare.com/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# In production, set to your backend deployment origin (e.g. https://api.syncnshare.com)
VITE_SOCKET_URL=http://localhost:5000
